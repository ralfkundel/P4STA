{
  "interfaces": {
    "access": [
      {
        "interface": "enp4s0f1",
        "type": "pppoe",
        "vlan-mode": "N:1",
        "qinq": true,
        "outer-vlan": 111,
        "inner-vlan": 7
      }
    ]
  },
  "pppoe": {
    "reconnect": true
  },
